diff --git a/Chapter 1/1.3/server.py b/Chapter 1/1.3/server.py
new file mode 100644
--- /dev/null	(date 1767750211554)
+++ b/Chapter 1/1.3/server.py	(date 1767750211554)
@@ -0,0 +1,22 @@
+import flask
+
+app = flask.Flask(__name__)
+
+@app.route("/")
+def index():
+    f = open("rates.csv", "r", encoding="utf-8")
+    st = "<table border='1'>"
+    rows = f.readlines()
+    for row in rows:
+        s = row.split(",")
+        if len(s) == 6:
+            st = st + "<tr>"
+            for t in s:
+                st = st + "<td>" + t + "</td>"
+            st = st + "</tr>"
+    st = st + "</table>"
+    f.close()
+    return st
+
+app.debug = True
+app.run()

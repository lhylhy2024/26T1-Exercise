diff --git a/Chapter 1/1.4/server.py b/Chapter 1/1.4/server.py
new file mode 100644
--- /dev/null	(date 1767750238584)
+++ b/Chapter 1/1.4/server.py	(date 1767750238584)
@@ -0,0 +1,28 @@
+import flask
+app = flask.Flask(__name__)
+
+@app.route("/")
+def index():
+    if "currency" in flask.request.values:
+        currency = flask.request.values.get("currency")
+    else:
+        currency = "美元"
+    f = open("rates.txt","r",encoding="utf-8")
+    st = "<table border='1'>"
+    rows = f.readlines()
+    i = 0
+    for row in rows:
+        s = row.split(",")
+        i = i + 1
+        if s[0] == currency or i == 1:
+            st = st + "<tr>"
+            for t in s:
+                st = st + "<td>" + t + "</td>"
+            st = st + "</tr>"
+            if i > 1:
+                break
+    st = st + "</table>"
+    f.close()
+    return st
+app.debug = True
+app.run()
